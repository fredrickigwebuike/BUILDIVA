# BUILDIVA Firebase configuration
# Create a Firebase Web App in the Firebase Console and copy its config here.
# Do NOT commit real secrets, service-account JSON, private keys or passwords.

VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=replace_me
VITE_FIREBASE_PROJECT_ID=replace_me
VITE_FIREBASE_STORAGE_BUCKET=replace_me
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me
VITE_FIREBASE_MEASUREMENT_ID=replace_me_optional
VITE_FIREBASE_APPCHECK_SITE_KEY=replace_me_when_enabled
